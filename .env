# =====================================================================
#  État des lieux – configuration (fichier lu par docker compose)
#  Après une modification : relancez demarrer.bat (ou docker compose up -d).
#  Une valeur par ligne, sans guillemets ; les lignes commençant par # sont ignorées.
# =====================================================================

# Code d'accès (4 caractères minimum). C'est le code initial : il peut ensuite
# être changé depuis l'application (Paramètres). Si vous modifiez cette valeur
# ici, elle redevient le code valable au prochain démarrage (utile en cas d'oubli).
ACCESS_CODE=1234

# Nom affiché dans l'application.
APP_TITLE=État des lieux

# Port sur lequel le PC répond (http://localhost:8080 sur le PC,
# http://<adresse-du-PC>:8080 depuis la tablette ou le téléphone).
PORT=8080

# Adresse du PC sur le réseau Wi-Fi, utilisée dans le QR code du téléphone.
# Laissez vide : demarrer.bat la détecte automatiquement à chaque lancement.
# Exemple : PUBLIC_URL=http://192.168.1.20:8080
PUBLIC_URL=

# Dossier du PC où sont stockées toutes les données (relatif à ce fichier ou absolu).
# Exemple Windows : DATA_PATH=D:/EtatsDesLieux/data
DATA_PATH=./data

# Durée de la connexion « Rester connecté » (jours).
SESSION_DAYS=30

# Protection contre les essais de code : nombre d'essais puis blocage (minutes).
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# Dossiers supprimés : conservés dans data/corbeille pendant N jours.
TRASH_DAYS=30

# Nombre de versions précédentes conservées pour chaque dossier (data/dossiers/<id>/historique).
HISTORY_KEEP=10

# Taille maximale d'une photo envoyée (Mo).
MAX_UPLOAD_MB=25

# HTTPS avec certificat auto-signé (true/false). Chiffre le Wi-Fi local, mais chaque
# appareil affichera un avertissement de sécurité à accepter une première fois.
HTTPS=false

# Fuseau horaire des journaux.
TZ=Europe/Paris
